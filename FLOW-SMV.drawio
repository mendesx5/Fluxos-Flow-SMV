        <mxCell id="m7eydBoCF1hzJjdzP2f9-144" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=10;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;fontFamily=Comic Sans MS;" value="IMPORTAR CHECKLIST DIRETAMENTE NO FLOW E ELE MESMO CONSEGUIR LER E CRIAR OS ACESSOS AUTOMATICAMENTE (DEPOIS DE UM TEMPO)." vertex="1">
