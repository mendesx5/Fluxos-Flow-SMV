        <mxCell id="m7eydBoCF1hzJjdzP2f9-147" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontFamily=Comic Sans MS;" value="GRUPO" vertex="1">
          <mxGeometry height="60" width="120" x="1880" y="1740" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-156" edge="1" parent="1" source="m7eydBoCF1hzJjdzP2f9-148" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;fontFamily=Comic Sans MS;" target="m7eydBoCF1hzJjdzP2f9-155">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-148" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontFamily=Comic Sans MS;" value="LOJAS" vertex="1">
          <mxGeometry height="60" width="120" x="1880" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-154" parent="1" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;fontFamily=Comic Sans MS;" value="&lt;ul&gt;&lt;li&gt;NA TELA INICIAL, AO ENTRAR NO SISTEMA, MOSTRAR TODOS OS GRUPOS QUE ESTÃO ATRIBUÍDOS AO SUPORTE. AO CLICAR NESSE GRUPO, EXPANDIR E MOSTRAR AS PRINCIPAIS INFORMAÇÕES DE COMO ESTÁ SUA SITUAÇÃO COMO GRUPO.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="100" width="370" x="2050" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-155" parent="1" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;fontFamily=Comic Sans MS;" value="&lt;ul&gt;&lt;li&gt;QUANTITATIVO DE DISPAROS EM RELAÇÃO AO QUE FOI CONTRATADO DE TODAS AS LOJAS ATRIBUÍDAS AO SUPORTE.&lt;/li&gt;&lt;ul&gt;&lt;li&gt;AVISOS RELACIONADOS AS LOJAS, POR EXEMPLO:&lt;br&gt;MONITORAMENTO DE ACESSO DOS VENDEDORES (MUITO TEMPO SEM ACESSAR A PLATAFORMA DURANTE O EVENTO);&lt;/li&gt;&lt;li&gt;LOJAS COM CONVERSÕES ABAIXO DO ESPERADO;&lt;/li&gt;&lt;li&gt;FALTA DE BASE (POR EXEMPLO, SE A BASE CHEGOU A 80% JÁ USADA, SURGIR UM AVISO NESSA TELA DE QUE A BASE ESTÁ ABAIXO DO QUE É NECESSÁRIO PARA OS DISPAROS)&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;EM RESUMO, UM CONTROLE GERAL DAS LOJAS&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="260" width="370" x="2050" y="1860" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-158" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=10;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;fontFamily=Comic Sans MS;" value="UM DASHBOARD MAIS ORGANIZADO PARA TER UM PANORÂMA GERAL DAS LOJAS ATRIBUÍDAS AO SUPORTE E NÃO PRECISAR PROCURAR LOJA POR LOJA, GRUPO POR GRUPO" vertex="1">
          <mxGeometry height="120" width="240" x="1680" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-164" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" value="PENSANDO EM EVENTOS DAS MONTADORAS:&lt;br&gt;&lt;br&gt;AS LOJAS PODEM SER MAIS CONECTADAS, DENTRO DE `EVENTOS GRUPO` PODE SE MARCAR OPÇÃO DE &quot;MONTADORA TAL&quot;, ISSO NÃO IMPACTARIA EM NADA NA DIVISÃO DAS LOJAS POR SUPORTE OU NOS EVENTOS, APENAS SERIA PARA APLICAÇÃO DE FILTROS PARA SE TER, POR EXEMPLO, UM PANORÂMA DE MAIS FÁCIL ACESSO DENTRO DA TELA INICIAL DO FLOW, SEM PRECISAR BUSCAR NÚMEROS DE LOJA POR LOJA.&lt;div&gt;TERIA NÚMEROS EM TEMPO REAL DOS GRUPOS E/OU LOJAS QUE ESTÃO FAZENDO PARTE DAQUELE EVENTO DA GM.&lt;/div&gt;&lt;div&gt;NOVAMENTE, NÃO IMPACTARIA, POR EXEMPLO EM NOME DO EVENTO QUE MUITAS VEZES OS GESTORES QUEREM USAR NOMES DIFERENTES AO INVÉS DE &quot;EVENTO SUPER MEGAVENDAS&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="440" x="120" y="2170" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-165" edge="1" parent="1" source="m7eydBoCF1hzJjdzP2f9-166" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;labelPadding=0 4;fontFamily=Comic Sans MS;" target="m7eydBoCF1hzJjdzP2f9-168">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-166" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fontFamily=Comic Sans MS;" value="GRUPO" vertex="1">
          <mxGeometry height="90" width="160" x="720" y="200" as="geometry" />
        </mxCell>
