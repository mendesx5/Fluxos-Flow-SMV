        <mxCell id="m7eydBoCF1hzJjdzP2f9-171" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontFamily=Comic Sans MS;" value="GESTOR" vertex="1">
          <mxGeometry height="60" width="120" x="740" y="430" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-187" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontColor=#FFFF00;" value="FLUXO FLOW:" vertex="1">
          <mxGeometry height="40" width="280" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-190" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontColor=#FFFF00;" value="MELHORIAS E MUDANÇAS SUGERIDAS:" vertex="1">
          <mxGeometry height="40" width="590" x="40" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-192" parent="1" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" value="&lt;ol&gt;&lt;li&gt;FILTRO DE ATIVOS E INATIVOS DENTRO DE USUÁRIOS&lt;/li&gt;&lt;li&gt;MELHOR RESPONSIVIDADE DO FLOW PARA SE ADAPTAR A TELAS, POR EXEMPLO, BOTÕES E BALÕES QUE PODERIAM SER MELHORES ORGANIZADOS&lt;/li&gt;&lt;li&gt;MUDAR O NOME DA PÁGINA (FLOW)&lt;/li&gt;&lt;li&gt;DEIXAR MAIS REGRADO A CONDIÇÃO DOS FORMULÁRIOS, MUITOS GESTORES ADICIONAM LOJAS DURANTE O EVENTO, PARA UMA MELHOR ORGANIZAÇÃO, EXIGIR ESSA MELHOR ORGANIZAÇÃO, TANTO SOBRE LOJAS, QUANTO SOBRE QUANTIDADE DE VENDEDORES - OBS&lt;/li&gt;&lt;li&gt;AO MEU VER, A NINA AINDA PODE SER MELHORADA, NA FORMA COMO AGE, COMO RESPONDE OU ATÉ MESMO COMO ENVIA ÁUDIO&lt;/li&gt;&lt;li&gt;MAIS FACILIDADE NA HORA DE REGISTRAR VENDA&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="320" width="320" x="120" y="2600" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-196" edge="1" parent="1" source="m7eydBoCF1hzJjdzP2f9-193" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="m7eydBoCF1hzJjdzP2f9-195">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-193" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="GERENTE" vertex="1">
          <mxGeometry height="60" width="120" x="2560" y="1847.5" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-195" parent="1" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;fontFamily=Comic Sans MS;" value="&lt;ul&gt;&lt;li&gt;NA TELA DO GERENTE DOS SUPORTES, TER UM PANORÂMA TAMBÉM SOBRE AS METAS, AO INVÉS DE ESTAR CRIANDO LISTAS DIVERSAS SOBRE METAS E RESULTADOS, LISTAR POR SUPORTE AS RESPECTIVAS LOJAS EM QUE ELES ESTEJAM RESPONSÁVEIS E SUAS METAS E BATIMENTO DE METAS CONFORME ATUALIZAÇÃO DOS PRÓPRIOS SUPORTES.&lt;/li&gt;&lt;li&gt;SUPORTES PODEREM ADICIONAR NOTAS NAS LOJAS, ONDE O GERENTE PODE VISUALIZAR PARA ENTENDER OBSERVAÇÕES OU AVISOS SOBRE DETERMINADAS LOJAS&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="275" width="380" x="2720" y="1740" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-197" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontColor=#FFFF00;" value="PEQUENAS SUGESTÕES:" vertex="1">
          <mxGeometry height="40" width="400" x="40" y="2520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
