          <mxGeometry height="90" width="160" x="720" y="315" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-169" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fontFamily=Comic Sans MS;" value="VENDEDOR" vertex="1">
          <mxGeometry height="60" width="120" x="740" y="520" as="geometry" />
        </mxCell>
        <mxCell id="m7eydBoCF1hzJjdzP2f9-170" edge="1" parent="1" source="m7eydBoCF1hzJjdzP2f9-171" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;labelPadding=0 4;fontFamily=Comic Sans MS;" target="m7eydBoCF1hzJjdzP2f9-169">
          <mxGeometry relative="1" as="geometry" />
